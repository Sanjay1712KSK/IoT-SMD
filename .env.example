# Copy this file to .env and edit.   (cp .env.example .env   /   copy .env.example .env)

# Where the backend pulls video from:
#   real ESP32-CAM:        http://<esp32-ip>:81/stream   (IP is shown on the Arduino LCD at boot)
#   tools/fake_esp32.py:   http://127.0.0.1:8081/stream
#   laptop webcam direct:  0
STREAM_URL=http://127.0.0.1:8081/stream

HOST=0.0.0.0
PORT=8000

# Shared secret for the web app and /trigger. Letters, digits, - and _ only (it goes into a URL).
# Must match API_TOKEN in firmware/esp32_cam/esp32_cam/secrets.h. Empty = no protection.
API_TOKEN=change-me-to-something-random

# auto = use face_recognition/dlib if installed, otherwise OpenCV YuNet+SFace
FACE_BACKEND=auto
# Empty = backend default (dlib 0.6, opencv 0.60). Lower = stricter (fewer false "known").
FACE_TOLERANCE=
# Downscale frames to this width before recognition (speed vs. range)
PROCESS_WIDTH=480
# Live feed: run recognition on every Nth frame
RECOGNIZE_EVERY_N=3
# Max time one door check looks at frames (UNKNOWN is decided early once 3 frames agree)
CHECK_WINDOW_S=1.0
# Same verdict is logged/alerted at most once per this many seconds
COOLDOWN_S=15

SNAPSHOT_MAX_AGE_DAYS=7

# Optional Telegram push alerts for unknown persons (see README). Leave ALERT_WEBHOOK empty to disable.
ALERT_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
