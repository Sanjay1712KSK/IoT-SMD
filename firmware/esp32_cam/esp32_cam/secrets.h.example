// Copy this file to secrets.h (same folder) and fill in your values. secrets.h is git-ignored.
#pragma once

#define WIFI_SSID      "YourWiFiName"        // 2.4 GHz network! The ESP32 cannot see 5 GHz.
#define WIFI_PASSWORD  "YourWiFiPassword"

// Optional extra networks (e.g. home WiFi + phone hotspot). The ESP32 joins whichever it finds.
// #define WIFI_SSID2     "OtherWiFi"
// #define WIFI_PASSWORD2 "OtherPassword"
// #define WIFI_SSID3     "ThirdWiFi"
// #define WIFI_PASSWORD3 "ThirdPassword"

// The ESP32 sends door checks to the computer that is watching its video stream (the backend),
// so you normally don't need the laptop's IP. BACKEND_URL is only used before the backend has connected.
#define BACKEND_URL    "http://192.168.1.10:8000"

// Must equal API_TOKEN in the backend's .env. Use letters/digits/-/_ only (it goes into a URL).
#define API_TOKEN      "change-me-to-something-random"

// Optional: fixed IP for the camera so STREAM_URL never changes (pick a free address on your network).
// #define STATIC_IP       "192.168.1.50"
// #define STATIC_GATEWAY  "192.168.1.1"

// Optional: mDNS name -> http://doorcam.local:81/stream
// #define MDNS_NAME "doorcam"
